# Use your local PostgreSQL socket directory or your remote database hostname.
PGHOST=/tmp
PGPORT=5432
PGDATABASE=scraper_dev
PGUSER=scraper_writer
PGPASSWORD=

# Optional alternatives and remote TLS settings.
# PGPASSFILE=/absolute/path/to/pgpass
# PGSSLROOTCERT=/absolute/path/to/database-ca.pem
# PGSSLMODE=disable  # Only for a local loopback TCP server without TLS.
